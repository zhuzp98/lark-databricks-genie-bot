# Copy to .env and fill in. Never commit .env.

# Databricks CLI / workspace
DATABRICKS_CONFIG_PROFILE=<PROFILE>
DATABRICKS_HOST=https://YOUR_WORKSPACE.cloud.databricks.com
DATABRICKS_USER_HOME=you@example.com
DATABRICKS_WAREHOUSE_ID=YOUR_WAREHOUSE_ID

# Lark Open Platform (local bot / bridge PoC)
LARK_APP_ID=cli_YOUR_LARK_APP_ID
LARK_APP_SECRET=
LARK_OPEN_API_BASE=https://open.larksuite.com

# App public URL (bind link; set in App env for production)
APP_PUBLIC_URL=https://YOUR_APP_NAME.aws.databricksapps.com

# UC persistence (App defaults; optional locally)
LARK_UC_PERSIST=1
LARK_UC_CATALOG=workspace
LARK_UC_SCHEMA=lark_integration

# Ops (optional Lark DM on Job failure)
# LARK_OPS_NOTIFY_OPEN_ID=ou_YOUR_LARK_OPEN_ID

# Local inbound uploads (optional)
# LARK_INBOUND_DIR=/tmp/lark_inbound
